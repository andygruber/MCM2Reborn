// mcm2-eos.exe's file details and manifest, so it shows as what it is: MCM2Reborn's online play.

#include <winver.h>

1 24 "helper.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MCM2Reborn"
            VALUE "FileDescription",  "MCM2Reborn online play (Epic Online Services)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "mcm2-eos"
            VALUE "LegalCopyright",   "MCM2Reborn contributors"
            VALUE "OriginalFilename", "mcm2-eos.exe"
            VALUE "ProductName",      "MCM2Reborn"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
